+import {
+  ditherRect,
+  dot,
+  fogBands,
+  glowRect,
+  hash01,
+  line,
+  mix,
+  mulberry32,
+  pick,
+  rect,
+  rint,
+  shade,
+  type Ctx,
+} from "./draw";
+import { neonV } from "./neon";
+import { NEON, SIGNS_V, SKY, SKY_STOPS } from "./palette";
+import { makeLayer, type CanvasFactory, type Layer } from "./types";
+
+/* --------------------------------------------------------------------- sky */
+
+export function buildSky(make: CanvasFactory, W: number, H: number): Layer {
+  const L = makeLayer(make, W, H);
+  const c = L.ctx;
+  for (let i = 0; i < SKY.length; i++) {
+    const y0 = Math.round(SKY_STOPS[i] * H);
+    const y1 = i + 1 < SKY.length ? Math.round(SKY_STOPS[i + 1] * H) : H;
+    rect(c, 0, y0, W, y1 - y0, SKY[i]);
+  }
+  // dithered seams between the colour bands
+  for (let i = 0; i < SKY.length - 1; i++) {
+    const y1 = Math.round(SKY_STOPS[i + 1] * H);
+    for (let x = 0; x < W; x++) {
+      if (x % 4 === 0) dot(c, x, y1 - 2, SKY[i + 1]);
+      if (x % 2 === 0) dot(c, x, y1 - 1, SKY[i + 1]);
+      if (x % 2 === 1) dot(c, x, y1, SKY[i]);
+      if (x % 4 === 2) dot(c, x, y1 + 1, SKY[i]);
+    }
+  }
+  const rng = mulberry32(8080);
+  // a few stars poking through the smog
+  for (let i = 0; i < Math.round((W * H) / 5200); i++) {
+    dot(c, rng() * W, rng() * H * 0.34, rng() < 0.3 ? "#8a7fd0" : "#4a4290");
+  }
+  // low clouds lit from below by the city
+  for (let i = 0; i < Math.max(8, Math.round(W / 45)); i++) {
+    const cx = rng() * W;
+    const cy = H * (0.3 + rng() * 0.32);
+    const cw = 50 + rng() * 120;
+    for (let k = 0; k < 4; k++) {
+      const w = cw * (1 - k * 0.2);
+      c.save();
+      c.globalAlpha = 0.2 + k * 0.04;
+      c.fillStyle = "#5a3a9a";
+      c.fillRect(Math.round(cx + (cw - w) / 2), Math.round(cy + k * 2), Math.round(w), 2);
+      c.restore();
+      ditherRect(c, cx + (cw - w) / 2, cy + k * 2 - 1, w, 1, "#9a4ab0", 0.35, k);
+    }
+  }
+  return L;
+}
+
+/* --------------------------------------------------------- distant skyline */
+
+export interface SkylineOpts {
+  minH: number;
+  maxH: number;
+  wMin: number;
+  wMax: number;
+  body: string;
+  rim: string;
+  haze: string;
+  hazeMax: number;
+  seed: number;
+  winP: number;
+  winCols: readonly string[];
+  neonP: number;
+  antennaP: number;
+  /** chance, per ~150 rows, of a lit advert panel on a tower */
+  panelP?: number;
+  /** chance of leaving a gap after a tower, so the layer behind shows through */
+  gapP?: number;
+  /** chance, per ~150 rows, of a vertical neon blade sign */
+  signP?: number;
+  /** y (from top) at which the layer's buildings stand */
+  baseY: number;
+}
+
+export interface SkylineResult {
+  layer: Layer;
+  blink: { x: number; y: number; col: string }[];
+}
+
+/**
+ * A skyline for the vertical descent: towers whose tops sit near the top of
+ * the layer and which run all the way down, so the city keeps going as the
+ * camera drops. `layerH` is the full height of the layer.
+ */
+export function buildSkyline(
+  make: CanvasFactory,
+  W: number,
+  layerH: number,
+  o: SkylineOpts,
+): SkylineResult {
+  const L = makeLayer(make, W, layerH);
+  const c = L.ctx;
+  const rng = mulberry32(o.seed);
+  const blink: SkylineResult["blink"] = [];
+
+  let x = -6;
+  while (x < W) {
+    const w = rint(rng, o.wMin, o.wMax);
+    const h = rint(rng, o.minH, o.maxH);
+    const top = o.baseY - h;
+    const body = mix(o.body, pick(rng, [NEON.vio, NEON.mag, NEON.cyan]), 0.04 + rng() * 0.06);
+    drawTower(c, rng, x, top, w, layerH, body, o, blink);
+    // sometimes a second, narrower tower hugs it for a stepped silhouette
+    if (rng() < 0.35) {
+      const w2 = Math.max(6, Math.round(w * (0.4 + rng() * 0.3)));
+      const h2 = Math.round(h * (0.55 + rng() * 0.3));
+      drawTower(c, rng, x + w - 2, o.baseY - h2, w2, layerH, shade(body, -0.08), o, blink);
+      x += w2 - 2;
+    }
+    x += w - 1 + rint(rng, 0, 3);
+    if (o.gapP && rng() < o.gapP) x += rint(rng, 8, 24);
+  }
+
+  // one even veil of distance haze over the whole layer
+  fogBands(c, 0, 0, layerH, W, o.haze, o.hazeMax, 1);
+  return { layer: L, blink };
+}
+
+function drawTower(
+  c: Ctx,
+  rng: () => number,
+  x: number,
+  top: number,
+  w: number,
+  H: number,
+  body: string,
+  o: SkylineOpts,
+  blink: SkylineResult["blink"],
+) {
+  rect(c, x, top, w, H - top, body);
+  // cool light from the street on one edge, a shadow on the other
+  const litLeft = rng() < 0.5;
+  rect(c, litLeft ? x : x + w - 1, top, 1, H - top, mix(body, o.rim, 0.55));
+  rect(c, litLeft ? x + w - 2 : x, top, 2, H - top, shade(body, -0.35));
+  rect(c, x, top, w, 1, mix(body, o.rim, 0.7));
+
+  // floor ledges
+  for (let ly = top + rint(rng, 16, 30); ly < H - 6; ly += rint(rng, 30, 52)) {
+    rect(c, x, ly, w, 1, mix(body, o.rim, 0.22));
+    rect(c, x, ly + 1, w, 1, shade(body, -0.25));
+  }
+
+  // windows, in runs of lit and dark floors so the tower reads as stacked storeys
+  const bp = o.winP * (0.4 + rng() * 1.2);
+  let on = rng() < 0.55;
+  for (let wy = top + 5; wy < H - 4; wy += 5) {
+    if (rng() < 0.16) on = !on;
+    const p = on ? Math.min(0.85, bp * 2.6) : bp * 0.2;
+    for (let wx = x + 3; wx < x + w - 3; wx += 3) {
+      if (rng() < p) rect(c, wx, wy, 1, 2, pick(rng, o.winCols));
+    }
+  }
+
+  // long glowing strips down a corner
+  if (rng() < o.neonP) {
+    for (let n = rint(rng, 1, 2); n > 0; n--) {
+      const col = pick(rng, [NEON.cyan, NEON.mag, NEON.mag, NEON.yel]);
+      const sy = top + rint(rng, 6, 80);
+      const sh = rint(rng, 30, 110);
+      const sx = litLeft ? x + 1 : x + w - 2;
+      ditherRect(c, sx - 2, sy, 5, sh, col, 0.22);
+      rect(c, sx, sy, 1, sh, col);
+    }
+  }
+
+  // lit advert panels and blade signs, scattered all the way down
+  if (o.panelP || o.signP) {
+    for (let py = top + rint(rng, 20, 90); py < H - 70; py += rint(rng, 90, 210)) {
+      if (o.panelP && w >= 14 && rng() < o.panelP) {
+        const pw = Math.min(w - 6, rint(rng, 8, w - 6));
+        const ph = rint(rng, 16, 44);
+        const px = x + 3 + rint(rng, 0, w - 6 - pw);
+        const col = pick(rng, [NEON.mag, NEON.cyan, NEON.yel, NEON.org, NEON.mag]);
+        glowRect(c, px, py, pw, ph, col, 6, 0.8);
+        rect(c, px - 1, py - 1, pw + 2, ph + 2, "#06030f");
+        for (let i = 0; i < ph; i++) rect(c, px, py + i, pw, 1, mix(col, "#12071f", 0.3 + 0.55 * (i / ph)));
+        rect(c, px, py, pw, 1, shade(col, 0.4));
+        if (rng() < 0.6) rect(c, px + 2, py + Math.floor(ph / 2), Math.max(2, pw - 4), 2, shade(col, 0.55));
+      } else if (o.signP && rng() < o.signP) {
+        const sx = x + rint(rng, 1, Math.max(2, w - 8));
+        neonV(c, sx, py, pick(rng, SIGNS_V), pick(rng, [NEON.mag, NEON.cyan, NEON.yel, NEON.org]), 0.8);
+      }
+    }
+  }
+
+  // roof gear
+  if (rng() < o.antennaP) {
+    const ah = rint(rng, 6, 18);
+    const ax = x + Math.floor(w / 2);
+    rect(c, ax, top - ah, 1, ah, mix(body, o.rim, 0.4));
+    dot(c, ax, top - ah, NEON.red);
+    blink.push({ x: ax, y: top - ah, col: NEON.red });
+  }
+  if (rng() < 0.18 && w > 12) {
+    const bw = rint(rng, 4, 7);
+    rect(c, x + 2, top - 3, bw, 3, shade(body, 0.08));
+  }
+}
+
+/* ---------------------------------------------------- elevated rail + train */
+
+export const TRAIN_LEN = 4 * 31;
+
+export function buildViaduct(layer: Layer, width: number, H: number, deckY: number, seed: number) {
+  const c = layer.ctx;
+  const rng = mulberry32(seed);
+  // pillars
+  for (let x = 14; x < width; x += 58 + rint(rng, 0, 10)) {
+    rect(c, x, deckY + 4, 5, H - deckY - 4, "#0f0a24");
+    rect(c, x, deckY + 4, 1, H - deckY - 4, "#2c2358");
+    rect(c, x - 2, deckY + 4, 9, 3, "#171034");
+    line(c, x + 5, deckY + 8, x + 58, deckY + 40, "#120c2a");
+  }
+  // the deck: dark girder with a lit underside
+  rect(c, 0, deckY, width, 5, "#150f30");
+  rect(c, 0, deckY, width, 1, "#4b3a8a");
+  rect(c, 0, deckY + 5, width, 1, "#0a0618");
+  for (let x = 4; x < width; x += 9) dot(c, x, deckY + 3, hash01(x) < 0.5 ? NEON.cyan : "#7a5ad0");
+  // rails and a catenary wire
+  rect(c, 0, deckY - 1, width, 1, "#2c2358");
+  for (let x = 0; x < width; x += 90) {
+    rect(c, x, deckY - 14, 1, 14, "#1e1745");
+    rect(c, x - 2, deckY - 14, 5, 1, "#1e1745");
+  }
+  for (let x = 0; x < width; x += 90) line(c, x, deckY - 13, x + 90, deckY - 13, "#2a2060");
+}
+
+/** One train: dark cars with a lit window band, a bright nose and a red tail. */
+export function drawTrain(c: Ctx, x: number, y: number, dir: 1 | -1, t: number) {
+  const carW = 30;
+  const h = 10;
+  for (let i = 0; i < 4; i++) {
+    const cx = x + i * (carW + 1);
+    rect(c, cx, y - h, carW, h, "#1b1338");
+    rect(c, cx, y - h, carW, 1, "#4b3a8a");
+    rect(c, cx, y - 2, carW, 2, "#0d0822");
+    // window band
+    for (let wx = cx + 2; wx < cx + carW - 3; wx += 6) {
+      const lit = hash01(i * 7 + wx) < 0.8;
+      rect(c, wx, y - h + 3, 5, 3, lit ? (hash01(wx * 3 + i) < 0.7 ? "#7ff3ff" : "#ffd36a") : "#241a48");
+      if (lit) rect(c, wx, y - h + 3, 5, 1, "#dffcff");
+    }
+    // door lines and a magenta stripe
+    rect(c, cx + carW - 1, y - h + 1, 1, h - 3, "#0d0822");
+    rect(c, cx, y - 4, carW, 1, "#a8267f");
+  }
+  const noseX = dir > 0 ? x + 4 * (carW + 1) - 1 : x - 2;
+  rect(c, noseX, y - 6, 2, 3, "#fff6c8");
+  glowRect(c, noseX - (dir > 0 ? 0 : 3), y - 7, 5, 5, "#ffe9a8", 6, 0.8);
+  const tailX = dir > 0 ? x : x + 4 * (carW + 1) - 2;
+  rect(c, tailX, y - 6, 2, 2, Math.floor(t * 2) % 2 ? "#ff3b5c" : "#a8203a");
+}
diff --git a/src/lib/pixel-world/tower.ts b/src/lib/pixel-world/tower.ts
new file mode 100644
index 0000000..32dde25
--- /dev/null
+++ b/src/lib/pixel-world/tower.ts
@@ -0,0 +1,316 @@
+import { ditherRect, dot, line, mulberry32, pick, rect, rint, shade, type Ctx, type Rng } from "./draw";
+import { acBig, brick, cableBundle, corrugated, discPx, pipeV, plate, poly, rust, slantRoof, slit, spill } from "./art";
+import { AMBER, CYAN, MAG, RED, backWall, billboard, shop, slab, stall, vendMachine, type Slab } from "./heroes";
+import { kanjiV, roundSign } from "./kanji";
+import { neonH } from "./neon";
+import type { Pool } from "./city";
+import { CAM, makeLayer, newFx, type CanvasFactory, type Fx, type Layer } from "./types";
+
+/** Rows from the bottom of the world to the top of the sidewalk. */
+export const GROUND = 72;
+
+/**
+ * The camera height (art pixels from the top of the world) at which each
+ * section of the page sits in the middle of the screen. The page maps its own
+ * scroll positions onto these.
+ */
+export const ANCHORS = { work: 380, skills: 800, about: 1150 } as const;
+
+export interface Tower {
+  near: Layer;
+  fx: Fx;
+  refl: Layer;
+  /** world y of the road's top edge, where reflections start */
+  reflTop: number;
+  /** world y of the top of the sidewalk */
+  gy: number;
+  /** world height in rows */
+  WH: number;
+  leftEdge: number;
+  rightEdge: number;
+}
+
+/** Wet pavement: near-black, with tiles, a curb, and light pooled where the neon lands. */
+function ground(c: Ctx, rng: Rng, pools: Pool[], W: number, WH: number, gy: number) {
+  rect(c, 0, gy, W, 15, "#0a0a14");
+  for (let x = -((gy * 5) % 22); x < W; x += 22) {
+    rect(c, x, gy + 1, 1, 7, "#14141f");
+    rect(c, x + 11, gy + 9, 1, 6, "#14141f");
+  }
+  rect(c, 0, gy, W, 1, "#2a2a3c");
+  rect(c, 0, gy + 8, W, 1, "#0e0e18");
+  rect(c, 0, gy + 15, W, 1, "#3a3a52");
+  rect(c, 0, gy + 16, W, 2, "#161622");
+  rect(c, 0, gy + 18, W, 1, "#020207");
+  rect(c, 0, gy + 19, W, WH - gy - 19, "#05050b");
+  for (let x = 8; x < W; x += 34) rect(c, x, gy + 38, 14, 1, "#6a5a22");
+  for (let i = 0; i < W / 70; i++) {
+    const px = rng() * W;
+    const py = gy + 26 + rng() * (WH - gy - 30);
+    ditherRect(c, px, py, rint(rng, 16, 44), rint(rng, 2, 3), "#1a1a3a", 0.5, i);
+  }
+  // pools of coloured light, flat to the ground
+  for (const p of pools) {
+    for (let dy = -5; dy <= 5; dy++) {
+      const hw = Math.round(p.r * Math.sqrt(Math.max(0, 1 - (dy / 5.5) ** 2)));
+      ditherRect(c, p.x - hw, gy + 9 + dy, hw * 2, 1, p.col, 0.2, dy);
+    }
+    for (let dy = -2; dy <= 2; dy++) {
+      const hw = Math.round(p.r * 0.5 * Math.sqrt(Math.max(0, 1 - (dy / 2.5) ** 2)));
+      ditherRect(c, p.x - hw, gy + 9 + dy, hw * 2, 1, p.col, 0.3, dy + 1);
+    }
+    for (let dy = 0; dy < 12; dy++) {
+      const hw = Math.round(p.r * (0.9 - dy * 0.05));
+      ditherRect(c, p.x - hw, gy + 20 + dy * 2, hw * 2, 1, p.col, 0.13, dy);
+    }
+  }
+}
+
+export function buildTower(make: CanvasFactory, W: number, H: number): Tower {
+  const WH = H + CAM;
+  const gy = WH - GROUND;
+  const near = makeLayer(make, W, WH);
+  const c = near.ctx;
+  const fx = newFx();
+  const pools: Pool[] = [];
+  const rng = mulberry32(20261115);
+  const narrow = W < 420;
+
+  const yWork = ANCHORS.work + Math.round(H / 2);
+  const ySk = ANCHORS.skills + Math.round(H / 2);
+  const yAb = ANCHORS.about + Math.round(H / 2);
+  const wallTop = yWork - 215;
+  const wallEnd = gy - 270;
+
+  /* ---- the walls of the alley: stacked slabs, each its own material ------- */
+  const reachSet = narrow ? [0.24, 0.32, 0.4] : [0.14, 0.2, 0.26, 0.32];
+  const slabs: Record<"L" | "R", Slab[]> = { L: [], R: [] };
+  for (const side of ["L", "R"] as const) {
+    let y = wallTop + (side === "R" ? 40 : 0);
+    let prev = -1;
+    while (y < wallEnd) {
+      let reach = Math.round(W * pick(rng, reachSet));
+      let g = 0;
+      while (prev >= 0 && Math.abs(reach - prev) < W * 0.05 && g++ < 8) reach = Math.round(W * pick(rng, reachSet));
+      const h = rint(rng, 150, 260);
+      slabs[side].push({ y0: y, y1: Math.min(y + h + 14, wallEnd + 40), reach });
+      prev = reach;
+      y += h;
+    }
+  }
+  const reachAt = (side: "L" | "R", y: number) => {
+    let r = 0;
+    for (const s of slabs[side]) if (y >= s.y0 && y <= s.y1) r = Math.max(r, s.reach);
+    return r || Math.round(W * 0.2);
+  };
+  for (const side of ["L", "R"] as const) {
+    for (const s of slabs[side]) slab(c, rng, fx, side, W, s, side === "L" ? RED : CYAN);
+  }
+
+  /* ---- hero 1: the billboard ------------------------------------------------ */
+  const bb = billboard(c, rng, fx, W, yWork);
+  // the red screen throws its light on the walls and the catwalk around it
+  spill(c, 0, bb.by - 40, W, bb.bh + 150, RED, 0.34, "down", 6);
+  spill(c, 0, bb.by - 40, bb.bx - 4, bb.bh + 150, RED, 0.3, "right", 4);
+  spill(c, bb.bx + bb.bw + 4, bb.by - 40, W - bb.bx - bb.bw, bb.bh + 150, RED, 0.3, "left", 4);
+
+  /* ---- cables crossing the alley ---------------------------------------------- */
+  for (let y = bb.cwY + 60; y < wallEnd - 40; y += rint(rng, 120, 190)) {
+    const xl = reachAt("L", y) - 2;
+    const xr = W - reachAt("R", y + 30) + 2;
+    if (xr - xl < 30) continue;
+    rect(c, xl - 3, y - 2, 5, 6, "#0a0a14");
+    rect(c, xr - 1, y + 28, 5, 6, "#0a0a14");
+    cableBundle(c, rng, xl, y, xr, y + 30, rint(rng, 16, 34), "#3a3a50");
+  }
+
+  /* ---- hero 2: a vending machine on a ledge, for Skills ------------------------ */
+  {
+    const pw = Math.min(104, Math.max(72, Math.round(W * 0.16)));
+    const px = W - pw + 6; // out at the right edge, clear of the page's own vending panel
+    const py = ySk + 64;
+    plate(c, rng, px, py, pw, 7, "#1a1a26");
+    line(c, px + 6, py + 7, px + pw - 20, py + 46, "#0c0c16");
+    line(c, px + 7, py + 7, px + pw - 19, py + 46, "#0c0c16");
+    for (let rx = px; rx < px + pw; rx += 6) rect(c, rx, py - 8, 1, 8, "#0a0a12");
+    rect(c, px, py - 8, pw, 1, "#2a2a3c");
+    vendMachine(c, rng, fx, px + 10, py, 48, 90, CYAN, pools);
+    fx.flick.push(neonH(c, px + 2, py - 124, "DRINK", MAG, 3, 1.3));
+    rect(c, px + 34, py - 108, 1, 18, "#05050a");
+  }
+  // a big round sake sign on the left wall
+  {
+    const y = ySk - 150;
+    const xl = reachAt("L", y);
+    fx.flick.push(roundSign(c, xl - 6, y, 28, RED));
+  }
+
+  /* ---- hero 3: a balcony with a lit window, for About ------------------------- */
+  {
+    const xl = reachAt("L", yAb);
+    const bw = Math.min(100, Math.max(64, Math.round(W * 0.18)));
+    const bx = Math.max(-6, xl - bw + 14);
+    const by = yAb + 44;
+    plate(c, rng, bx, by, bw, 6, "#1a1a26");
+    line(c, bx + 4, by + 6, bx + bw - 6, by + 40, "#0c0c16");
+    for (let rx = bx; rx < bx + bw; rx += 5) rect(c, rx, by - 10, 1, 10, "#0a0a12");
+    rect(c, bx, by - 10, bw, 1, "#2a2a3c");
+    slit(c, rng, bx + 8, by - 48, 26, 38, AMBER);
+    for (let k = 0; k < 3; k++) {
+      const gx = bx + 40 + k * 14;
+      rect(c, gx, by - 10 - 6, 8, 6, "#3a1a2a");
+      for (let j = 0; j < 9; j++) dot(c, gx + rint(rng, -2, 9), by - 18 - rint(rng, 0, 9), pick(rng, ["#0f5a45", "#1c8a62", "#2fd08a"]));
+    }
+    acBig(c, rng, bx + 8, by - 84, 34, 24, AMBER);
+    fx.flick.push(neonH(c, bx + bw + 8, by - 70, "OPEN", AMBER, 3, 1.2));
+    kanjiV(c, bx + bw + 30, by - 36, "月", CYAN, 1.2, 2);
+  }
+
+  /* ---- the street ---------------------------------------------------------------- */
+  const top = gy - 124;
+  backWall(c, rng, fx, W, gy - 300, gy);
+  if (!narrow) {
+    shop(c, rng, fx, pools, Math.round(W * 0.58), W - Math.round(W * 0.58) + 10, gy);
+  }
+  const sw = narrow ? 116 : Math.min(250, Math.round(W * 0.36));
+  const sx = narrow ? 10 : Math.round(W * 0.07);
+  stall(c, rng, fx, pools, sx, sw, gy);
+  const vx = sx + sw + (narrow ? 12 : 22);
+  vendMachine(c, rng, fx, vx, gy + 2, narrow ? 36 : 50, narrow ? 72 : 100, CYAN, pools);
+  if (!narrow) {
+    // the alley between the machine and the shop: black, with one cold light at the far end
+    const gx = vx + 70;
+    const gw = Math.round(W * 0.58) - gx - 6;
+    if (gw > 8) {
+      rect(c, gx, top - 40, gw, gy - top + 40, "#020206");
+      ditherRect(c, gx, gy - 40, gw, 40, CYAN, 0.1, 0);
+      ditherRect(c, gx + Math.round(gw / 2) - 2, gy - 14, 4, 14, CYAN, 0.5, 0);
+    }
+  }
+  void top;
+  void corrugated;
+  void brick;
+  void pipeV;
+  void poly;
+  void rust;
+  void slantRoof;
+  void discPx;
+  void kanjiV;
+  void shade;
+
+  ground(c, rng, pools, W, WH, gy);
+
+  /* ---- reflections: a darkened, rippled mirror of the street -------------------- */
+  const reflTop = gy + 19;
+  const RH = WH - reflTop;
+  const refl = makeLayer(make, W, RH);
+  const rc = refl.ctx;
+  for (let i = 0; i < RH; i++) {
+    const sy = gy - 1 - i;
+    if (sy < 0) break;
+    const jitter = Math.round(Math.sin(i * 1.7) * 1.6);
+    rc.save();
+    rc.globalAlpha = 0.7 * Math.pow(1 - i / RH, 1.05);
+    rc.drawImage(near.canvas, 0, sy, W, 1, jitter, i, W, 1);
+    rc.restore();
+  }
+  // wet streaks: light smeared sideways along the road
+  for (let i = 0; i < W / 10; i++) {
+    ditherRect(rc, rng() * W, rint(rng, 0, RH - 1), rint(rng, 8, 30), 1, pick(rng, [RED, CYAN, MAG, "#8a9aff"]), 0.14, i);
+  }
+
+  return { near, fx, refl, reflTop, gy, WH, leftEdge: Math.round(W * 0.2), rightEdge: Math.round(W * 0.8) };
+}
+
+/* ---------------------------------------------------------------- foreground */
+
+/** Pitch-black silhouettes close to the camera: rooftops, railings, tanks, cables. */
+export function buildForeground(make: CanvasFactory, W: number, H: number): Layer {
+  const layerH = H + Math.ceil(CAM * 1.35) + 4;
+  const L = makeLayer(make, W, layerH);
+  const c = L.ctx;
+  const rng = mulberry32(31337);
+  const INK = "#020207";
+  // where on this layer a thing sits so that it appears at screen height `sy` when the camera is at `cam`
+  const at = (cam: number, sy: number) => Math.round(cam * 1.35 + sy);
+
+  const rim = (x: number, y: number, w: number, col: string) => {
+    rect(c, x, y, w, 1, col);
+    ditherRect(c, x, y + 1, w, 2, col, 0.35, 0);
+  };
+
+  // rooftop, bottom-left, for the first screen: a water tank, an antenna mast, an AC block
+  {
+    const y = at(0, H - 70);
+    const w = Math.round(W * 0.34);
+    rect(c, -4, y, w, 110, INK);
+    rim(-4, y, w, RED);
+    rect(c, 18, y - 38, 34, 38, INK); // tank
+    rect(c, 18, y - 42, 34, 5, INK);
+    for (const lx of [22, 46]) rect(c, lx, y - 2, 3, 3, INK);
+    rim(18, y - 42, 34, RED);
+    rect(c, 70, y - 80, 2, 80, INK); // mast
+    rect(c, 62, y - 70, 18, 1, INK);
+    rect(c, 64, y - 56, 14, 1, INK);
+    dot(c, 71, y - 82, RED);
+    rect(c, w - 50, y - 24, 40, 24, INK); // AC
+    rim(w - 50, y - 24, 40, RED);
+    // railing
+    for (let rx = 0; rx < w; rx += 7) rect(c, rx, y - 16, 1, 16, INK);
+    rect(c, 0, y - 16, w, 2, INK);
+  }
+  // rooftop, bottom-right
+  {
+    const y = at(0, H - 40);
+    const w = Math.round(W * 0.3);
+    const x = W - w;
+    rect(c, x + 4, y, w + 4, 110, INK);
+    rim(x + 4, y, w, RED);
+    for (let k = 0; k < 3; k++) {
+      rect(c, x + 14 + k * 30, y - 52 - k * 10, 3, 52 + k * 10, INK);
+      dot(c, x + 15 + k * 30, y - 54 - k * 10, k === 1 ? CYAN : RED);
+    }
+    rect(c, x + 10, y - 22, 58, 22, INK);
+    rim(x + 10, y - 22, 58, RED);
+  }
+  // a balcony railing with plants, in front of the billboard shot
+  {
+    const y = at(ANCHORS.work, H - 36);
+    const w = Math.round(W * 0.28);
+    rect(c, -4, y, w, 120, INK);
+    for (let rx = 0; rx < w; rx += 5) rect(c, rx, y - 22, 1, 22, INK);
+    rect(c, 0, y - 22, w, 2, INK);
+    rim(0, y - 22, w, RED);
+    for (let k = 0; k < 3; k++) {
+      rect(c, 8 + k * 30, y - 30, 14, 8, INK);
+      for (let j = 0; j < 16; j++) rect(c, 6 + k * 30 + rint(rng, 0, 16), y - 38 - rint(rng, 0, 12), rint(rng, 2, 5), 2, INK);
+    }
+  }
+  // a water tower, right
+  {
+    const y = at(ANCHORS.work, H - 20);
+    const x = W - Math.round(W * 0.2);
+    rect(c, x, y - 70, 56, 52, INK);
+    poly(c, [[x - 2, y - 70], [x + 28, y - 90], [x + 58, y - 70]], INK);
+    rect(c, x + 6, y - 20, 3, 60, INK);
+    rect(c, x + 46, y - 20, 3, 60, INK);
+    line(c, x + 7, y - 18, x + 47, y + 30, INK);
+    line(c, x + 47, y - 18, x + 7, y + 30, INK);
+    rim(x, y - 70, 56, RED);
+  }
+  // cables sagging across, thick and black
+  for (let y = 80; y < layerH - 40; y += rint(rng, 230, 340)) {
+    const a = rint(rng, -40, 40);
+    cableBundle(c, rng, -6, y, W + 6, y + a, rint(rng, 20, 44), "#1a1a28");
+  }
+  void slantRoof;
+  void rust;
+  void shade;
+  void discPx;
+  void brick;
+  void corrugated;
+  void pipeV;
+  void kanjiV;
+  void rect;
+  return L;
+}
